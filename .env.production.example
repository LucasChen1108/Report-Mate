# PRODUCTION environment for the Report Mate backend (AWS Lightsail).
# Copy to .env on the Lightsail instance and fill in real values.
# NEVER commit the filled-in file. The LLM key is the team's shared credit pool.

# --- Database: AWS Lightsail-managed PostgreSQL ---
# Use the managed database's endpoint. sslmode=require for a managed DB.
DATABASE_URL=postgres://USER:PASSWORD@DB-ENDPOINT.rds.amazonaws.com:5432/reportmate?sslmode=require

# --- Auth: REQUIRED in production ---
# A long random secret. Anyone with it can mint a session, so treat it like a
# password and generate a fresh one for prod:  openssl rand -base64 48
JWT_SIGNING_KEY=REPLACE-WITH-openssl-rand-base64-48

# --- LLM gateway (organizer-provided, Bedrock-backed) ---
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=REPLACE-WITH-TEAM-KEY
LLM_MODEL=sonnet4.5

# --- Server ---
PORT=8080
ENV=production

# --- Frontend: serve the built SPA from the same process/origin ---
# Absolute path to the built frontend on the instance (frontend/dist copied
# next to the binary). When set, the backend serves the app AND the API on one
# origin, keeping the session cookie same-origin. Leave blank to run API-only.
STATIC_DIR=/opt/reportmate/web

# --- Report exports ---
# Point at a directory on a persistent volume so exports outlive a redeploy.
EXPORT_DIR=/opt/reportmate/exports
