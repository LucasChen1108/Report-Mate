# Copy to .env and fill in real values. NEVER commit a real .env.
# The LLM gateway key is tied to the team's shared credit pool — keep it
# backend-only, never expose it to the frontend.

# --- Frontend ---
VITE_AUTH_MODE=mock
VITE_API_BASE_URL=http://localhost:8080

# --- Backend: database (AWS Lightsail-managed PostgreSQL) ---
DATABASE_URL=postgres://user:password@host:5432/reportmate?sslmode=require

# --- Backend: LLM gateway (organizer-provided, Bedrock-backed, Ollama-compatible) ---
LLM_GATEWAY_URL=https://gateway.example/api
LLM_GATEWAY_API_KEY=your-team-api-key-here
# Model/identifier exposed by the gateway (confirm against the current build)
LLM_MODEL=

# --- Server ---
PORT=8080
# Deployment environment: "development" (default) or "production".
# ENV=production enables Secure on the HttpOnly session cookie. Production
# traffic must terminate HTTPS before it reaches the browser.
ENV=development

# --- Optional development fixtures ---
# Normal migrations never install shared login credentials. On a disposable
# local database only, run `ENV=development go run ./cmd/devseed` from backend/.
# The command refuses every other environment.

# --- Backend: report exports ---
# Directory the rendered HTML report snapshots are written to on
# save-and-export. Relative paths resolve against the server's working
# directory; point this at a real volume in a deployment so exports outlive
# the process.
EXPORT_DIR=./var/exports
